---
eleventyExcludeFromCollections: true
---
{#- No sitemap in staging. Every page there is noindex and robots.txt disallows the
    whole site, so a sitemap listing all 63 would contradict both, and check-links
    rightly fails a build where a noindex page is listed. permalink returns real
    boolean false to suppress the file entirely. -#}
{%- if env.staging %}{% set dummy = 1 %}{% endif -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for page in collections.all %}
{#- page.url is false for flag-gated pages that were never written; without this
    guard absoluteUrl() falls back to the site root and emits a duplicate homepage. -#}
{%- if page.url and page.data.sitemap !== false and not page.data.eleventyExcludeFromCollections and "noindex" not in (page.data.robots or "") %}
  <url>
    <loc>{{ page.url | absoluteUrl(site.url) }}</loc>
    <lastmod>{{ page.date | isoDate }}</lastmod>
    <changefreq>{% if page.url == "/" %}weekly{% elif page.data.pageType == "post" %}monthly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if page.url == "/" %}1.0{% elif page.data.pageType == "city" %}0.9{% elif page.data.pageType == "situation" %}0.85{% elif page.data.pageType == "legal" %}0.3{% else %}0.7{% endif %}</priority>
  </url>
{%- endif %}
{%- endfor %}
</urlset>
