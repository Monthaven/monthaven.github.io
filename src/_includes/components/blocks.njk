{#- Shared content blocks. Boilerplate repeating across pages is fine and normal;
    what must stay unique per page is the local/market/proof content. -#}

{% macro howItWorks(city=null) %}
<ol class="steps">
  <li>
    <div>
      <h3>Tell us about the house</h3>
      <p>Address, condition, and what's going on. Two minutes on the form or one call
      to {{ site.phoneDisplay }}. You don't need to have anything ready.</p>
    </div>
  </li>
  <li>
    <div>
      <h3>We set an appointment and walk it with you</h3>
      <p>Someone from Monthaven comes out and walks{% if city %} the {{ city.name }} property{% else %} the property{% endif %}
      in person, at a time that works for you. We'd rather meet you than price a house off a
      spreadsheet. No inspector, no contractor parade, and don't clean up on our account.
      It takes about 20 minutes.</p>
    </div>
  </li>
  <li>
    <div>
      <h3>Written offer within {{ site.offerWindowHours }} hours</h3>
      <p>In writing, with the math behind it. No obligation. If listing with an agent
      would net you more, we'll say so.</p>
    </div>
  </li>
  <li>
    <div>
      <h3>You pick the closing date</h3>
      <p>Usually {{ site.closeDaysMin }} to {{ site.closeDaysMax }} days, at a North Carolina
      closing attorney. Need longer? We'll wait. Need to stay a few weeks after closing? Ask.</p>
    </div>
  </li>
</ol>
{% endmacro %}


{% macro comparison(city=null) %}
{% set tn = site.twoNumberPromise.enabled %}
<div class="table-scroll">
  <table>
    <caption>What each route actually costs you{% if city %} in {{ city.name }}{% endif %}. Figures are typical for North Carolina; your situation may differ.</caption>
    <thead>
      <tr>
        <th scope="col">&nbsp;</th>
        <th scope="col">Selling to Monthaven</th>
        <th scope="col">Listing with an agent</th>
        {% if tn %}<th scope="col">Brokerage cash-offer programs</th>{% endif %}
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">Commission</th>
        <td>None</td>
        <td>Typically 5&ndash;6% of the sale price</td>
        {% if tn %}<td>A listing fee still applies, commonly around 3%, even on the cash offer</td>{% endif %}
      </tr>
      <tr>
        <th scope="row">Do you sign before you see a number?</th>
        <td>No &mdash; you see our offer first, with no agreement</td>
        <td>Yes &mdash; a listing agreement comes first</td>
        {% if tn %}<td>Yes &mdash; typically an exclusive listing agreement before any offer is shown</td>{% endif %}
      </tr>
      <tr>
        <th scope="row">Seller closing costs</th>
        <td>We pay them</td>
        <td>You pay them</td>
        {% if tn %}<td>Usually you pay them</td>{% endif %}
      </tr>
      <tr>
        <th scope="row">Repairs before sale</th>
        <td>None &mdash; we buy as-is</td>
        <td>Usually required to show and to pass inspection</td>
        {% if tn %}<td>Depends on which buyer in their network takes it</td>{% endif %}
      </tr>
      <tr>
        <th scope="row">Price changes after inspection</th>
        <td>None &mdash; we don't re-trade on condition</td>
        <td>Commonly renegotiated after the buyer's inspection</td>
        {% if tn %}<td>Depends on the end buyer's terms</td>{% endif %}
      </tr>
      <tr>
        <th scope="row">Who actually buys the house?</th>
        <td>We do, with our own funds</td>
        <td>A retail buyer, usually with a mortgage</td>
        {% if tn %}<td>An investor from their buyer network, not the brokerage</td>{% endif %}
      </tr>
      <tr>
        <th scope="row">Cleanout</th>
        <td>Included &mdash; leave what you want</td>
        <td>Your cost</td>
        {% if tn %}<td>Usually your cost</td>{% endif %}
      </tr>
      <tr>
        <th scope="row">Showings</th>
        <td>One walkthrough</td>
        <td>Ongoing, on the buyer's schedule</td>
        {% if tn %}<td>Usually one assessment</td>{% endif %}
      </tr>
      <tr>
        <th scope="row">Financing falls through?</th>
        <td>Can't &mdash; there is no loan</td>
        <td>A real risk right up to closing day</td>
        {% if tn %}<td>Depends on the end buyer</td>{% endif %}
      </tr>
      <tr>
        <th scope="row">Time to close</th>
        <td>{{ site.closeDaysMin }}&ndash;{{ site.closeDaysMax }} days, your date</td>
        <td>Often 60&ndash;90 days from listing to funding</td>
        {% if tn %}<td>Commonly around 21 days</td>{% endif %}
      </tr>
      <tr>
        <th scope="row">Sale price</th>
        <td>Below full retail &mdash; that's the trade</td>
        <td>Full retail, if it appraises and closes</td>
        {% if tn %}<td>Near retail, before the listing fee comes out</td>{% endif %}
      </tr>
    </tbody>
  </table>
</div>
<p class="small muted mt-4">
  We're not going to pretend a cash offer beats a retail sale on price. It doesn't.
  It beats it on certainty, speed, and everything you don't have to do. If your house
  shows well and you have three months, list it &mdash; and we'll tell you that on the call.
</p>
{% endmacro %}


{% macro valueStack() %}
{% set vs = proof.valueStack %}
{% set shown = [] %}
{% for r in vs.rows %}{% if r.pct or r.amount %}{% set shown = (shown.push(r), shown) %}{% endif %}{% endfor %}
{% if shown.length %}
<div class="table-scroll">
  <table>
    <caption>{{ vs.basisNote }} Percentages are published North Carolina figures, not our estimates.</caption>
    <thead>
      <tr>
        <th scope="col">What you skip by not listing</th>
        <th scope="col">Typical cost</th>
      </tr>
    </thead>
    <tbody>
      {% for r in shown %}
      <tr>
        <th scope="row">
          {{ r.label }}
          {% if r.source %}<br><span class="small muted">{{ r.pct }}% &mdash; {{ r.source }}</span>{% endif %}
        </th>
        <td>{% if r.pct %}{{ (vs.basisPrice * r.pct / 100) | round | usd }}{% else %}{{ r.amount | usd }}{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{% if vs.hiddenCosts and vs.hiddenCosts.length %}
<div class="mt-6">
  <h3>What the percentages don't show</h3>
  <p class="mt-4">
    The numbers above are the ones you can put in a spreadsheet. These are the ones sellers
    tell us about afterward, and they're usually what made them pick up the phone:
  </p>
  <ul class="cost-list mt-4">
    {% for c in vs.hiddenCosts %}<li>{{ c }}</li>{% endfor %}
  </ul>
  <p class="mt-5">
    None of that is an argument that you shouldn't list your house. Plenty of people should,
    and we'll tell you when you're one of them. It's just the part of the comparison that
    doesn't show up until you're already three weeks into it.
  </p>
</div>
{% endif %}
{% endmacro %}


{% macro situationGrid(city=null) %}
<div class="grid grid--3">
  {% for s in situations %}
  <a class="card card--link" href="/{{ s.urlPrefix }}-nc/">
    <h3>{{ s.label }}</h3>
    <p>{{ s.painPoints[0] }}</p>
  </a>
  {% endfor %}
</div>
{% endmacro %}


{% macro faqList(items) %}
<div class="faq">
  {% for f in items %}
  <details>
    <summary>{{ f.q }}</summary>
    <div><p>{{ f.a }}</p></div>
  </details>
  {% endfor %}
</div>
{% endmacro %}


{% macro testimonials(citySlug=null) %}
{% set real = [] %}
{% for t in proof.testimonials %}
  {% if not t.placeholder and (not citySlug or t.citySlug == citySlug) %}
    {% set real = (real.push(t), real) %}
  {% endif %}
{% endfor %}
{% if real.length %}
<div class="grid grid--2">
  {% for t in real %}
  <figure class="testimonial">
    <blockquote><p>{{ t.quote }}</p></blockquote>
    <figcaption>{{ t.name }} &mdash; {{ t.city }}</figcaption>
  </figure>
  {% endfor %}
</div>
{% else %}
<p class="placeholder-note">
  <strong>Awaiting real testimonials.</strong> Nothing is published here until Alec supplies
  real quotes from real sellers with permission to use them. Fabricated reviews are both a
  legal problem and the fastest way to lose the trust this page exists to build.
  Add them to <code>src/_data/proof.json</code>.
</p>
{% endif %}
{% endmacro %}


{#- Out-of-area deals never render in a city-page slot. On a city page we filter by
    citySlug, which excludes them by construction; elsewhere they carry an explicit
    label saying where they actually were. Showing a Triad deal as if it were local
    is exactly the thing this site accuses competitors of. -#}
{% macro caseStudies(citySlug=null) %}
{% set real = [] %}
{% for c in proof.caseStudies %}
  {% if not c.placeholder %}
    {% if citySlug %}
      {% if c.citySlug == citySlug and not c.outOfArea %}{% set real = (real.push(c), real) %}{% endif %}
    {% else %}
      {% set real = (real.push(c), real) %}
    {% endif %}
  {% endif %}
{% endfor %}
{% if real.length %}
<div class="stack-lg">
  {% for c in real %}
  <article class="case-study">
    <p class="case-study__addr">
      {{ c.location }}
      {% if c.outOfArea %}<span class="tag tag--warn">Outside our current service area</span>{% endif %}
    </p>
    {% if c.outOfAreaNote %}<p class="small muted">{{ c.outOfAreaNote }}</p>{% endif %}
    <dl>
      <dt>Situation</dt><dd>{{ c.situation }}</dd>
      <dt>Condition</dt><dd>{{ c.condition }}</dd>
      {% if c.size %}<dt>Size</dt><dd>{{ c.size }}</dd>{% endif %}
      {% if c.timeline %}<dt>Timeline</dt><dd>{{ c.timeline }}</dd>{% endif %}
      {% if c.daysToClose %}<dt>Closed in</dt><dd>{{ c.daysToClose }} days</dd>{% endif %}
      <dt>Outcome</dt><dd>{{ c.outcome }}</dd>
    </dl>
    {% if c.scope and c.scope.length %}
    <details class="mt-4">
      <summary><strong>Everything we did to it</strong></summary>
      <ul class="mt-3">{% for s in c.scope %}<li>{{ s }}</li>{% endfor %}</ul>
    </details>
    {% endif %}
    {% if c.lesson %}<p class="mt-4"><strong>{{ c.lesson }}</strong></p>{% endif %}
  </article>
  {% endfor %}
</div>
{% else %}
<p class="placeholder-note">
  <strong>{% if citySlug %}No closed deal published for this city yet.{% else %}Awaiting real closed deals.{% endif %}</strong>
  Nothing appears here until Alec supplies actual properties and outcomes.
  Add them to <code>src/_data/proof.json</code>.
</p>
{% endif %}
{% endmacro %}


{% macro nearbyCities(city) %}
{% set near = cities | citiesBySlug(city.nearby) %}
{% if near.length %}
<ul class="pill-links">
  {% for n in near %}
  <li><a href="/sell-my-house-fast-{{ n.slug }}-nc/">Sell my house fast in {{ n.name }}, NC</a></li>
  {% endfor %}
</ul>
{% endif %}
{% endmacro %}


{% macro ctaBand(heading=null, sub=null) %}
<section class="section section--dark">
  <div class="wrap--narrow text-center">
    <h2>{{ heading or "Find out what your house is worth to us" }}</h2>
    <p class="lead mt-4" style="color:#c9ded4">
      {{ sub or ("A written offer within " + site.offerWindowHours + " hours. No fee, no obligation, and no pressure if the number isn't right for you.") }}
    </p>
    <div class="btn-row mt-6" style="justify-content:center">
      <a class="btn btn--cta" href="/get-offer/">Get My Cash Offer</a>
      <a class="btn btn--on-dark" href="tel:{{ site.phoneRaw }}">Call {{ site.phoneDisplay }}</a>
    </div>
  </div>
</section>
{% endmacro %}


{% macro noRetradePromise(compact=false) %}
{% set nr = site.noRetrade %}
<div class="promise">
  <h3 class="promise__head">{{ nr.headline }}</h3>
  <p>{{ nr.body }}</p>
  {% if not compact %}
  <p class="mt-4">{{ nr.limitsIntro }}</p>
  <ul class="promise__limits">
    {% for l in nr.limits %}<li>{{ l }}</li>{% endfor %}
  </ul>
  <p class="promise__closer">{{ nr.closer }}</p>
  {% endif %}
</div>
{% endmacro %}


{#- Everything below renders ONLY when site.twoNumberPromise.enabled is true.
    Do not remove the guards. See the _README in src/_data/site.json. -#}
{% macro twoNumberPromise(compact=false) %}
{% if site.twoNumberPromise.enabled %}
{% set tn = site.twoNumberPromise %}
<div class="promise promise--accent">
  <h3 class="promise__head">{{ tn.name }}</h3>
  <p>{{ tn.summary }}</p>
  {% if not compact %}
  <ol class="promise__stages">
    <li><strong>First, the cash offer.</strong> {{ tn.stage1 }}</li>
    <li><strong>Only if you'd rather list.</strong> {{ tn.stage2 }}</li>
    <li><strong>{{ tn.stage3Heading }}.</strong> {{ tn.stage3 }}</li>
  </ol>
  <p class="small muted">{{ tn.disclosure }}</p>
  <p class="mt-4"><a href="/two-number-promise/">How the Two-Number Promise works &rarr;</a></p>
  {% endif %}
</div>
{% endif %}
{% endmacro %}


{% macro licenseeDisclosure() %}
{% if site.twoNumberPromise.enabled %}
<p class="footer__disclaimer">{{ site.twoNumberPromise.disclosure }}{% if site.licenseNumber %} NC real estate license #{{ site.licenseNumber }}.{% endif %}</p>
{% endif %}
{% endmacro %}


{#- compact=true renders names only. Used on city pages: the full bodies are ~90
    words of identical text and repeating them across 10 city pages pushes them over
    the duplicate-content ceiling. The full version lives on /how-it-works/. -#}
{% macro guarantee(compact=false) %}
{% if proof.guarantee.enabled and proof.guarantee.items.length %}
{% if compact %}
<ul class="pill-links">
  {% for g in proof.guarantee.items %}<li><a href="/how-it-works/">{{ g.name }}</a></li>{% endfor %}
</ul>
{% else %}
<div class="guarantees">
  {% for g in proof.guarantee.items %}
  <div class="guarantee">
    <h3 class="guarantee__name">{{ g.name }}</h3>
    <p>{{ g.body }}</p>
  </div>
  {% endfor %}
</div>
<p class="small muted mt-4">
  Both of these are in writing on every offer we make. Ask us to point them out.
</p>
{% endif %}
{% endif %}
{% endmacro %}


{#- Real numbers from a real flip. The whole value of this block is that the third
    number is small. Do not "improve" it. -#}
{% macro marginDisclosure() %}
{% set m = proof.marginDisclosure %}
{% if m.enabled %}
<div class="margin-disclosure">
  <h3>{{ m.headline }}</h3>
  <div class="margin-figures">
    <div class="margin-figure">
      <span class="margin-figure__label">We paid</span>
      <span class="margin-figure__value">{{ m.purchase | usd }}</span>
    </div>
    <div class="margin-figure">
      <span class="margin-figure__label">It resold for</span>
      <span class="margin-figure__value">{{ m.sale | usd }}</span>
    </div>
    <div class="margin-figure margin-figure--punch">
      <span class="margin-figure__label">We made</span>
      <span class="margin-figure__value">{% if m.netApprox %}about {% endif %}{{ m.net | usd }}</span>
    </div>
  </div>
  <p>{{ m.body }}</p>
  <p>{{ m.why }}</p>
  <p class="margin-disclosure__point">{{ m.point }}</p>
</div>
{% endif %}
{% endmacro %}


{% macro repairPadding() %}
{% set rp = proof.repairPadding %}
{% if rp.enabled %}
<div class="table-scroll">
  <table>
    <caption>
      What these items actually run, against what a padded estimate says. These are our own
      figures from our own renovations, not published data. A contractor may quote you
      differently and that is a fair argument to have &mdash; which is the point.
    </caption>
    <thead>
      <tr>
        <th scope="col">Item</th>
        <th scope="col">What it actually runs</th>
        <th scope="col">What a padded estimate says</th>
      </tr>
    </thead>
    <tbody>
      {% for r in rp.rows %}
      <tr>
        <th scope="row">{{ r.item }}</th>
        <td>{{ r.real }}</td>
        <td>{{ r.padded }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p class="mt-4"><strong>{{ rp.pattern }}</strong></p>
{% endif %}
{% endmacro %}
